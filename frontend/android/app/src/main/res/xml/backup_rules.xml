<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower: keep app data (including the refresh token in
     shared_prefs/CapacitorStorage.xml) out of Auto Backup. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
